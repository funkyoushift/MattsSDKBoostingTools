{
  "name": "msbt-afk-relay",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "AfkRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AfkRoom"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "RATE",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
