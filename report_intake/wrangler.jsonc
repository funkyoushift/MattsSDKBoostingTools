{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msbt-failure-reports",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "r2_buckets": [{"binding": "REPORTS", "bucket_name": "msbt-private-failure-reports"}],
  "ratelimits": [{"name": "UPLOAD_RATE", "namespace_id": "1004", "simple": {"limit": 4, "period": 60}}]
}
